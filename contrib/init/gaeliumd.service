[Unit]
Description=Gaelium's distributed currency daemon
After=network.target

[Service]
User=gaelium
Group=gaelium

Type=forking
PIDFile=/var/lib/gaeliumd/gaeliumd.pid
ExecStart=/usr/bin/gaeliumd -daemon -pid=/var/lib/gaeliumd/gaeliumd.pid \
-conf=/etc/gaelium/gaelium.conf -datadir=/var/lib/gaeliumd -disablewallet

Restart=always
PrivateTmp=true
TimeoutStopSec=60s
TimeoutStartSec=2s
StartLimitInterval=120s
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
