bin_PROGRAMS += qt/test/test_gaelium-qt
TESTS += qt/test/test_gaelium-qt

TEST_QT_MOC_CPP = \
  qt/test/moc_compattests.cpp \
  qt/test/moc_rpcnestedtests.cpp \
  qt/test/moc_uritests.cpp

if ENABLE_WALLET
TEST_QT_MOC_CPP += \
  qt/test/moc_paymentservertests.cpp \
  qt/test/moc_wallettests.cpp
endif

TEST_QT_H = \
  qt/test/compattests.h \
  qt/test/rpcnestedtests.h \
  qt/test/uritests.h \
  qt/test/paymentrequestdata.h \
  qt/test/paymentservertests.h \
  qt/test/wallettests.h

TEST_GAELIUM_CPP = \
  test/test_gaelium.cpp

TEST_GAELIUM_H = \
  test/test_gaelium.h

qt_test_test_gaelium_qt_CPPFLAGS = $(AM_CPPFLAGS) $(GAELIUM_INCLUDES) $(GAELIUM_QT_INCLUDES) \
  $(QT_INCLUDES) $(QT_TEST_INCLUDES) $(PROTOBUF_CFLAGS)

qt_test_test_gaelium_qt_SOURCES = \
  qt/test/compattests.cpp \
  qt/test/rpcnestedtests.cpp \
  qt/test/test_main.cpp \
  qt/test/uritests.cpp \
  $(TEST_QT_H) \
  $(TEST_GAELIUM_CPP) \
  $(TEST_GAELIUM_H)
if ENABLE_WALLET
qt_test_test_gaelium_qt_SOURCES += \
  qt/test/paymentservertests.cpp \
  qt/test/wallettests.cpp \
  wallet/test/wallet_test_fixture.cpp
endif

nodist_qt_test_test_gaelium_qt_SOURCES = $(TEST_QT_MOC_CPP)

qt_test_test_gaelium_qt_LDADD = $(LIBGAELIUMQT) $(LIBGAELIUM_SERVER)
if ENABLE_WALLET
qt_test_test_gaelium_qt_LDADD += $(LIBGAELIUM_WALLET)
endif
if ENABLE_ZMQ
qt_test_test_gaelium_qt_LDADD += $(LIBGAELIUM_ZMQ) $(ZMQ_LIBS)
endif
qt_test_test_gaelium_qt_LDADD += $(LIBGAELIUM_CLI) $(LIBGAELIUM_COMMON) $(LIBGAELIUM_UTIL) $(LIBGAELIUM_CONSENSUS) $(LIBGAELIUM_CRYPTO) $(LIBUNIVALUE) $(LIBLEVELDB) \
  $(LIBLEVELDB_SSE42) $(LIBMEMENV) $(BOOST_LIBS) $(QT_DBUS_LIBS) $(QT_TEST_LIBS) $(QT_LIBS) \
  $(QR_LIBS) $(PROTOBUF_LIBS) $(BDB_LIBS) $(SSL_LIBS) $(CRYPTO_LIBS) $(MINIUPNPC_LIBS) $(LIBSECP256K1) \
  $(EVENT_PTHREADS_LIBS) $(EVENT_LIBS)
qt_test_test_gaelium_qt_LDFLAGS = $(RELDFLAGS) $(AM_LDFLAGS) $(QT_LDFLAGS) $(LIBTOOL_APP_LDFLAGS)
qt_test_test_gaelium_qt_CXXFLAGS = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)

CLEAN_GAELIUM_QT_TEST = $(TEST_QT_MOC_CPP) qt/test/*.gcda qt/test/*.gcno

CLEANFILES += $(CLEAN_GAELIUM_QT_TEST)

test_gaelium_qt : qt/test/test_gaelium-qt$(EXEEXT)

test_gaelium_qt_check : qt/test/test_gaelium-qt$(EXEEXT) FORCE
	$(MAKE) check-TESTS TESTS=$^

test_gaelium_qt_clean: FORCE
	rm -f $(CLEAN_GAELIUM_QT_TEST) $(qt_test_test_gaelium_qt_OBJECTS)
